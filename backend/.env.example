# Copy this file to .env and adjust as needed. All values here are optional -
# defaults live in app/config.py.

# All cameras run simultaneously, each as its own panel on the dashboard.
# "source" can be a local webcam index ("0", "1"), an RTSP/network CCTV URL,
# or a path to a video file. Must be valid JSON on one line.
CAMERA_SOURCES=[{"id":"laptop","label":"Laptop Webcam","source":"0"},{"id":"cctv","label":"Office CCTV","source":"rtsp://user:pass@192.168.1.50:554/stream1"},{"id":"sample","label":"Sample Video","source":"data/test_videos/cctv_sample.mp4"}]
CAMERA_RECONNECT_AFTER_SEC=5.0

DETECTION_INTERVAL_SEC=0.3
RECOGNITION_THRESHOLD=0.45
INSIGHTFACE_MODEL_NAME=buffalo_l
# Raise DETECTION_SIZE (e.g. 960/1280) and lower DET_THRESH (e.g. 0.3) for
# CCTV footage with small/far-away faces.
DETECTION_SIZE=640
DET_THRESH=0.5

ENROLL_SHOTS=4
ENROLL_CAPTURE_INTERVAL_SEC=1.0
ENROLL_MAX_RETRIES_PER_SHOT=8
ENROLL_RETRY_SLEEP_SEC=0.3

UNKNOWN_ALERT_SECONDS=3.0
ALERT_COOLDOWN_SECONDS=30.0

HEAD_YAW_THRESHOLD_DEG=35.0
HEAD_PITCH_THRESHOLD_DEG=35.0
IDLE_ALERT_SECONDS=60.0
IDLE_ALERT_COOLDOWN_SECONDS=120.0

MJPEG_FPS=15

DATABASE_URL=sqlite:///./data/app.db
SNAPSHOT_DIR=./data/snapshots
